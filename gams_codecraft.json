{
  "plugins": [
    { "$file": "https://github.com/kkgams/plugin.fs/releases/download/v0.2.0/plugin.fs.wasm" },
    { "$file": "https://github.com/kkgams/plugin.layout/releases/download/v0.2.0/plugin.layout.wasm" },
    { "$file": "https://github.com/kkgams/plugin.font/releases/download/v0.1.1/plugin.font.wasm" }
  ],
  "ui": {
    "keys": [],
    "theme": {
      "url": "build.nosync/themes/codecraft.css"
    },
    "services": {
      "ui-context": {
        "url": {
          "$file": {
            "url": "https://github.com/kkgams/ui-service.context/releases/download/v0.2.0/ui-service.context-0.2.0.zip",
            "entry": "ui-plugins/context.js"
          }
        }
      },
      "ui-keys": {
        "url": {
          "$file": {
            "url": "https://github.com/kkgams/ui-service.keys/releases/download/v0.2.0/ui-service.keys-0.2.0.zip",
            "entry": "ui-plugins/keys.js"
          }
        }
      },
      "ui-toast": {
        "url": {
          "$file": {
            "url": "https://github.com/kkgams/ui-service.toast/releases/download/v0.2.0/ui-service.toast-0.2.0.zip",
            "entry": "ui-plugins/toast.js"
          }
        }
      },
      "ui-popup": {
        "url": {
          "$file": {
            "url": "https://github.com/kkgams/ui-service.popup/releases/download/v0.2.0/ui-service.popup-0.2.0.zip",
            "entry": "ui-plugins/popup.js"
          }
        }
      },
      "ui-tooltip": {
        "url": {
          "$file": {
            "url": "https://github.com/kkgams/ui-service.tooltip/releases/download/v0.2.0/ui-service.tooltip-0.2.0.zip",
            "entry": "ui-plugins/tooltip.js"
          }
        }
      },
      "ui-layout": {
        "url": {
          "$file": {
            "url": "https://github.com/kkgams/ui-service.layout/releases/download/v0.2.0/ui-service.layout-0.2.0.zip",
            "entry": "ui-plugins/layout.js"
          }
        },
        "config": {
          "layout": "<view-files />"
        }
      }
    },
    "views": {
      "view-files": {
        "url": {
          "$file": {
            "url": "https://github.com/kkgams/view.files/releases/download/v1.0.0/view.files-1.0.0.zip",
            "entry": "views/view-files.js"
          }
        },
        "label": "Files",
        "group": "Project",
        "internal": false,
        "config": {
          "open": {
            "default": "files-default"
          }
        }
      },
      "view-tilemap": {
        "url": {
          "$file": {
            "url": "https://github.com/kkgams/view.tilemap/releases/download/v0.2.2/view.tilemap.zip",
            "entry": "views/view-tilemap.js"
          }
        },
        "label": "Tilemap",
        "group": "Project",
        "internal": false
      },
      "view-world": {
        "url": {
          "$file": {
            "url": "https://github.com/kkgams/view.world/releases/download/v0.5.0/view.world.zip",
            "entry": "views/view-world.js"
          }
        },
        "label": "World",
        "group": "Project",
        "internal": false,
        "config": {
          "renderers": {
            "rectangle": {
              "url": {
                "$file": {
                  "url": "https://github.com/kkgams/view.world/releases/download/v0.5.0/view.world.zip",
                  "entry": "world-renderers/rectangle.js"
                }
              },
              "match": {
                "render": "rectangle"
              },
              "config": {
                "origin": [0, 0]
              }
            },
            "sprite": {
              "url": {
                "$file": {
                  "url": "https://github.com/kkgams/view.world/releases/download/v0.5.0/view.world.zip",
                  "entry": "world-renderers/sprite.js"
                }
              },
              "match": {
                "render": "sprite"
              },
              "config": {
                "origin": [0.5, 0.5]
              }
            },
            "tilemap": {
              "url": {
                "$file": {
                  "url": "https://github.com/kkgams/view.world/releases/download/v0.5.0/view.world.zip",
                  "entry": "world-renderers/tilemap.js"
                }
              },
              "match": {
                "render": "tilemap"
              },
              "config": {
                "origin": [0, 1]
              }
            },
            "text": {
              "url": {
                "$file": {
                  "url": "https://github.com/kkgams/view.world/releases/download/v0.5.0/view.world.zip",
                  "entry": "world-renderers/text.js"
                }
              },
              "match": {
                "render": "text"
              },
              "config": {
                "origin": [0, 0]
              }
            },
            "nine": {
              "url": {
                "$file": {
                  "url": "https://github.com/kkgams/view.world/releases/download/v0.5.0/view.world.zip",
                  "entry": "world-renderers/nine.js"
                }
              },
              "match": {
                "render": "nine"
              },
              "config": {
                "origin": [0, 0]
              }
            }
          },
          "inputs": {},
          "invert": {
            "x": false,
            "y": false
          }
        }
      },
      "view-synth": {
        "url": {
          "$file": {
            "url": "https://github.com/kkgams/view.synth/releases/download/v0.2.0/view.synth.zip",
            "entry": "views/view-synth.js"
          }
        },
        "label": "Synth",
        "group": "Project",
        "internal": false
      },
      "view-nine": {
        "url": {
          "$file": {
            "url": "https://github.com/kkgams/view.nine/releases/download/v0.1.1/view.nine.zip",
            "entry": "views/view-nine.js"
          }
        },
        "label": "Nine-slice",
        "group": "Project",
        "internal": false
      },
      "tilemap-settings": {
        "url": {
          "$file": {
            "url": "https://github.com/kkgams/view.tilemap/releases/download/v0.2.2/view.tilemap-settings.zip",
            "entry": "views/tilemap-settings.js"
          }
        },
        "label": "Tilemap Settings",
        "internal": true
      },
      "view-props": {
        "url": {
          "$file": {
            "url": "https://github.com/kkgams/view.project-tools/releases/download/v0.2.1/view.props.zip",
            "entry": "views/view-props.js"
          }
        },
        "label": "Properties",
        "internal": true
      },
      "files-rename": {
        "url": {
          "$file": {
            "url": "https://github.com/kkgams/view.files/releases/download/v1.0.0/view.files-1.0.0.zip",
            "entry": "views/files-rename.js"
          }
        },
        "label": "Rename File",
        "internal": true
      },
      "files-default": {
        "url": {
          "$file": {
            "url": "https://github.com/kkgams/view.files/releases/download/v1.0.0/view.files-1.0.0.zip",
            "entry": "views/files-default.js"
          }
        },
        "label": "File Info",
        "internal": true
      }
    }
  }
}
