@layer theme {
    :root {
        --base-bg: #1a1411;
        --surface: #241a14;
        --surface-elevated: #35261c;
        --base-border: #6d5036;
        --base-text: #f6ead0;
        --base-text-muted: #cdb98f;
        --base-ink: #140e0b;
        --accent: #f2c25a;
        --codecraft-disabled-button-text: #a88f72;
        --codecraft-header-enamel: #241c2c;
    }

    @media (forced-colors: none) {
        @supports selector(::-webkit-scrollbar) {
            :root {
                --codecraft-scrollbar-size: 9px;
            }

            ::-webkit-scrollbar {
                width: var(--codecraft-scrollbar-size);
                height: var(--codecraft-scrollbar-size);
            }

            ::-webkit-scrollbar-track,
            ::-webkit-scrollbar-corner {
                background: transparent;
            }

            ::-webkit-scrollbar-track:vertical {
                margin-block: var(--codecraft-scrollbar-size);
                background: linear-gradient(#6b6660, #6b6660) center / 1px 100% no-repeat;
            }

            ::-webkit-scrollbar-track:horizontal {
                margin-inline: var(--codecraft-scrollbar-size);
            }

            ::-webkit-scrollbar-thumb {
                border: 1px solid transparent;
                border-radius: 999px;
                background: var(--base-text-muted) padding-box;
            }

            ::-webkit-scrollbar-thumb:hover {
                background-color: var(--base-text);
            }

            ::-webkit-scrollbar-button {
                display: none;
            }
        }

        @supports not selector(::-webkit-scrollbar) {
            * {
                scrollbar-width: thin;
                scrollbar-color: var(--base-text-muted) transparent;
            }
        }
    }

    view-area {
        padding: 14px;
    }

    view-area::before,
    view-area::after {
        content: "";
        position: absolute;
        inset: 0;
        pointer-events: none;
    }

    /* Layer the original strips instead of using border-image, which can fail
       to repaint after splitting panes in WebKit. Clip the strips at the corners. */
    view-area::before {
        padding-inline: 14px;
        background:
            url("data:image/png;base64,{{baguette-tl}}") left top / 14px 14px no-repeat padding-box,
            url("data:image/png;base64,{{baguette-tr}}") right top / 14px 14px no-repeat padding-box,
            url("data:image/png;base64,{{baguette-bl}}") left bottom / 14px 14px no-repeat padding-box,
            url("data:image/png;base64,{{baguette-br}}") right bottom / 14px 14px no-repeat padding-box,
            url("data:image/png;base64,{{baguette-t}}") left top / 2400px 14px repeat-x content-box,
            url("data:image/png;base64,{{baguette-b}}") left bottom / 2400px 14px repeat-x content-box;
    }

    view-area::after {
        padding-block: 14px;
        background:
            url("data:image/png;base64,{{baguette-l}}") left top / 14px 2400px repeat-y content-box,
            url("data:image/png;base64,{{baguette-r}}") right top / 14px 2400px repeat-y content-box;
    }

    view-popup {
        grid-template-rows: minmax(0, 1fr);
        padding-block: var(--space-6);
    }

    view-popup::part(container) {
        --codecraft-popup-close-size: 32px;
        --codecraft-popup-close-offset: -8px;
        position: relative;
        padding: 14px;
        border: 0;
        box-shadow: var(--shadow);
        overflow: visible;
    }

    :host(view-popup) [part~="container"]::before,
    :host(view-popup) [part~="container"]::after {
        content: "";
        position: absolute;
        inset: 0;
        pointer-events: none;
    }

    :host(view-popup) [part~="container"]::before {
        z-index: 1;
        padding-inline: 34px;
        background:
            url("data:image/png;base64,{{cadre-tl}}") left top / 34px 34px no-repeat padding-box,
            url("data:image/png;base64,{{cadre-tr}}") right top / 34px 34px no-repeat padding-box,
            url("data:image/png;base64,{{cadre-bl}}") left bottom / 34px 34px no-repeat padding-box,
            url("data:image/png;base64,{{cadre-br}}") right bottom / 34px 34px no-repeat padding-box,
            url("data:image/png;base64,{{cadre-t}}") left top / 2400px 14px repeat-x content-box,
            url("data:image/png;base64,{{cadre-b}}") left bottom / 2400px 14px repeat-x content-box;
    }

    :host(view-popup) [part~="container"]::after {
        padding-block: 34px;
        background:
            url("data:image/png;base64,{{cadre-l}}") left top / 14px 2400px repeat-y content-box,
            url("data:image/png;base64,{{cadre-r}}") right top / 14px 2400px repeat-y content-box;
    }

    view-area::part(header) {
        --codecraft-header-top-cover: var(--codecraft-header-enamel);
    }

    view-area::part(header),
    view-popup::part(header) {
        display: flex;
        align-items: center;
        gap: var(--space-2);
        min-inline-size: 0;
        min-block-size: 36px;
        padding-inline: 20px;
        border: 0;
        background:
            linear-gradient(var(--codecraft-header-top-cover, transparent) 10%, transparent 10%),
            url("data:image/png;base64,{{bandeau-l}}") left center / 20px 100% no-repeat padding-box,
            url("data:image/png;base64,{{bandeau-r}}") right center / 20px 100% no-repeat padding-box,
            url("data:image/png;base64,{{bandeau-m}}") left center / 2400px 100% repeat-x content-box
            var(--codecraft-header-enamel);
    }

    @media (forced-colors: none) {
        aside {
            --codecraft-legend-background: var(--codecraft-header-enamel);
            background-color: var(--codecraft-header-enamel);
        }
    }

    view-area::part(view-select) {
        flex: 0 0 auto;
        field-sizing: content;
        min-inline-size: 0;
        max-inline-size: 45%;
        min-block-size: var(--control-height);
        padding-inline: var(--space-2) var(--space-5);
        border: 0;
        border-radius: 0;
        color: var(--base-text);
        color-scheme: dark;
        background:
            linear-gradient(45deg, transparent 50%, currentColor 50%) right 8px center / 4px 4px no-repeat,
            linear-gradient(135deg, currentColor 50%, transparent 50%) right 4px center / 4px 4px no-repeat;
        font: inherit;
        font-weight: 700;
        cursor: pointer;
    }

    view-area::part(view-select):hover {
        color: var(--accent);
    }

    view-area::part(view-select):focus-visible {
        outline: 2px solid var(--border-focus);
        outline-offset: -2px;
    }

    view-popup > [slot="title"] {
        min-inline-size: 0;
        overflow-wrap: anywhere;
    }

    @media (forced-colors: none) {
        view-popup {
            --codecraft-legend-background: #241c2c;
            background: radial-gradient(ellipse at center, rgb(36 28 44 / 0.42), rgb(12 8 16 / 0.78));
            -webkit-backdrop-filter: blur(4px);
            backdrop-filter: blur(4px);
        }

        @media (prefers-reduced-transparency: reduce) {
            view-popup {
                background: #18121d;
                -webkit-backdrop-filter: none;
                backdrop-filter: none;
            }
        }

        view-popup::part(container) {
            background: radial-gradient(ellipse at 42% 36%, #2a2338, #1e192a 65%, #17131f);
        }

        view-popup::part(header) {
            flex: none;
            display: grid;
            grid-template: 7fr auto 1fr / minmax(0, 1fr);
            gap: 0;
            min-block-size: 48px;
            padding: 0;
            background: var(--codecraft-header-enamel);
        }

        view-popup:not(:has(> [slot="header-controls"]:not(:empty, [hidden])))::part(header) {
            /* Leave room for the floating plaque below the frame's top edge. */
            min-block-size: 14px;
        }

        view-popup > [slot="header-controls"] {
            grid-row: 2;
        }

        view-popup > [slot="title"] {
            position: absolute;
            z-index: 2;
            inset-block-start: 5px;
            inset-inline: 0;
            translate: 0 -50%;
            align-content: center;
            inline-size: max-content;
            max-inline-size: calc(100% - 2 * var(--codecraft-popup-close-size));
            min-block-size: 42px;
            margin-inline: auto;
            padding: var(--space-1) 16px;
            padding-inline-start: 45px;
            border-image: url("data:image/png;base64,{{cartouche}}") 12 32 fill / 6px 16px stretch;
            color: var(--base-text);
            text-align: center;

            &::before {
                content: "";
                position: absolute;
                inset-inline-start: 16px;
                inset-block: 0;
                margin-block: auto;
                inline-size: 25px;
                block-size: 30px;
                background: url("data:image/png;base64,{{blason}}") center / contain no-repeat;
            }
        }

        view-popup footer {
            flex-wrap: wrap;
            justify-content: flex-end;
            align-items: center;
            padding: var(--space-2) var(--space-3);
            border-block-start: 1px solid #b18447;
            background: linear-gradient(#41221d, #2e1717);

            & > output:not(:empty) {
                flex: 1 1 auto;
                padding: 0;
                background: none;
            }

            & > output:empty {
                display: none;
            }
        }
    }

    view-popup::part(close) {
        position: absolute;
        inset-block-start: var(--codecraft-popup-close-offset);
        inset-inline-end: var(--codecraft-popup-close-offset);
        z-index: 2;
        inline-size: var(--codecraft-popup-close-size);
        block-size: var(--codecraft-popup-close-size);
        min-block-size: 0;
        margin: 0;
        padding: 0;
        border: 0;
        border-radius: 50%;
        background: url("data:image/png;base64,{{medaillon}}") center / 100% 100% no-repeat var(--surface);
        color: var(--base-text);
        font-size: 16px;
    }

    view-popup::part(close):hover {
        filter: brightness(1.25);
    }

    view-popup::part(close):active {
        filter: brightness(0.85);
    }

    view-popup::part(close):focus-visible {
        outline: 2px solid var(--base-text);
        outline-offset: -2px;
    }

    @media (forced-colors: active) {
        view-popup::part(close) {
            border: 1px solid ButtonText;
            background: ButtonFace;
            color: ButtonText;
        }

        view-popup::part(close):focus-visible {
            outline-color: Highlight;
        }
    }

    view-area [slot="header-controls"],
    view-popup > [slot="header-controls"] {
        flex: 0 1 auto;
        margin-inline-start: auto;
        flex-wrap: nowrap;
        justify-content: safe flex-end;
        overflow-x: auto;
    }

    @media (forced-colors: none) {
        [slot="header-controls"] button:is(:disabled, [aria-disabled="true"]) {
            color: var(--codecraft-disabled-button-text);
            cursor: default;

            &:not(:has(> i:only-child)) {
                background: var(--surface);
                border-color: var(--base-border);
            }
        }

        button:not([part~="close"], [slot="header-controls"], [slot="header-controls"] *, [role="tablist"] > [role="tab"]),
        thead > tr > th[scope="col"][role="button"]:is([aria-pressed], [aria-selected]) {
            --codecraft-button-art: url("data:image/png;base64,{{btn-n-l}}"), url("data:image/png;base64,{{btn-n-r}}"), url("data:image/png;base64,{{btn-n-m}}");
            background: var(--codecraft-button-art);
            background-position: left center, right center, left center;
            background-size: 8px 100%, 8px 100%, 800px 100%;
            background-repeat: no-repeat, no-repeat, repeat-x;
            border: 0;
            border-radius: 0;
            color: var(--base-text);
            transition: none;

            &.accent {
                color: var(--accent);
            }

            &:hover:not(:disabled, [aria-disabled="true"]) {
                --codecraft-button-art: url("data:image/png;base64,{{btn-h-l}}"), url("data:image/png;base64,{{btn-h-r}}"), url("data:image/png;base64,{{btn-h-m}}");
            }

            &:active:not(:disabled, [aria-disabled="true"]),
            &:is(th[aria-pressed="true"], th[aria-selected="true"]) {
                --codecraft-button-art: url("data:image/png;base64,{{btn-p-l}}"), url("data:image/png;base64,{{btn-p-r}}"), url("data:image/png;base64,{{btn-p-m}}");
            }

            &:is(th[aria-pressed="true"], th[aria-selected="true"]) {
                color: var(--accent);
            }

            &.danger {
                --codecraft-button-art: url("data:image/png;base64,{{btn-or-n-l}}"), url("data:image/png;base64,{{btn-or-n-r}}"), url("data:image/png;base64,{{btn-or-n-m}}");
            }

            &.danger:hover:not(:disabled, [aria-disabled="true"]) {
                --codecraft-button-art: url("data:image/png;base64,{{btn-or-h-l}}"), url("data:image/png;base64,{{btn-or-h-r}}"), url("data:image/png;base64,{{btn-or-h-m}}");
            }

            &.danger:active:not(:disabled, [aria-disabled="true"]) {
                --codecraft-button-art: url("data:image/png;base64,{{btn-or-p-l}}"), url("data:image/png;base64,{{btn-or-p-r}}"), url("data:image/png;base64,{{btn-or-p-m}}");
            }

            &:focus-visible {
                outline: 2px solid var(--accent);
                outline-offset: -2px;
            }

            &:is(:disabled, [aria-disabled="true"]) {
                color: var(--codecraft-disabled-button-text);
                opacity: 0.75;
                cursor: default;
            }
        }
    }

    :is(table.compact-actions > :is(thead, tbody, tfoot) > tr > :is(th, td), th.compact-actions, td.compact-actions) {
        font-size: 8px;

        & :is(button, input, select, textarea) {
            font-size: var(--font-md);
        }
    }

    table.compact-actions:has(> tbody > tr > :is(th, td) > [role="buttongroup"] > button > i:only-child),
    table:has(> tbody > tr > :is(th, td).compact-actions > button > i:only-child,
              > tbody > tr > :is(th, td).compact-actions > [role="buttongroup"] > button > i:only-child) {
        table-layout: auto;
    }

    :is(table.compact-actions > tbody > tr > :is(th, td), tbody > tr > :is(th, td).compact-actions):has(
        > button > i:only-child, > [role="buttongroup"] > button > i:only-child
    ) {
        inline-size: 1%;
        padding-block: 0;
        text-align: center;

        &:last-child {
            text-align: end;
        }
    }

    thead > tr > td > [role="buttongroup"]:only-child:has(> button > i:only-child) {
        display: flex;
        justify-content: flex-end;
        padding: 0;
    }

    /* Share iron faces across toolbars and compact table actions. */
    [slot="header-controls"] button:has(> i:only-child),
    thead > tr > td > [role="buttongroup"]:only-child > button:has(> i:only-child),
    :is(table.compact-actions > :is(thead, tbody, tfoot) > tr > :is(th, td), td.compact-actions, th.compact-actions)
        > button:has(> i:only-child),
    :is(table.compact-actions > :is(thead, tbody, tfoot) > tr > :is(th, td), td.compact-actions, th.compact-actions)
        > [role="buttongroup"] > button:has(> i:only-child) {
        &:not([slot="header-controls"] *) {
            box-sizing: border-box;
            flex: none;
            align-self: center;
            inline-size: 20px;
            block-size: 18px;
            min-inline-size: 0;
            min-block-size: 0;
            padding: 0;

            & > i {
                font-size: 12px;
            }

            [role="buttongroup"] > button + & {
                margin-inline-start: 1px;
            }
        }

        @media (forced-colors: none) {
            --codecraft-action-art: url("data:image/png;base64,{{bouton-n}}");
            border-color: transparent;
            border-radius: 0;
            background: var(--codecraft-action-art) center / 100% 100% no-repeat border-box;

            &:not([slot="header-controls"] *) {
                border: 0;
            }

            & > i {
                text-shadow: 0 1px 1px #140e0b;
            }

            &.danger:not(:disabled, [aria-disabled="true"]) {
                color: #ff9a95;
            }

            &:hover:not(:disabled, [aria-disabled="true"]) {
                --codecraft-action-art: url("data:image/png;base64,{{bouton-h}}");
            }

            &:active:not(:disabled, [aria-disabled="true"]),
            [slot="header-controls"] &[aria-pressed="true"]:not(:disabled, [aria-disabled="true"]) {
                --codecraft-action-art: url("data:image/png;base64,{{bouton-p}}");
            }

            &:is(:disabled, [aria-disabled="true"]) {
                opacity: 0.75;
            }
        }
    }

    @media (forced-colors: none) {
        /* Crop only the artwork edges shared by adjacent iron buttons. */
        [slot="header-controls"] [role="buttongroup"] > button:has(> i:only-child) {
            background-size: calc(100% + var(--codecraft-trim-start, 0px) + var(--codecraft-trim-end, 0px)) 100%;
            background-position-x: calc(-1 * var(--codecraft-trim-start, 0px));

            &:dir(rtl) {
                background-position-x: calc(-1 * var(--codecraft-trim-end, 0px));
            }

            button:has(> i:only-child) + & {
                --codecraft-trim-start: 2px;
            }

            &:has(+ button > i:only-child) {
                --codecraft-trim-end: 2px;
            }
        }

        view-tooltip {
            padding: var(--space-2);
            border: 4px solid #b18447;
            border-image: url("data:image/png;base64,{{portrait-frame}}") 12 / 6px stretch;
            background: radial-gradient(ellipse at 42% 36%, #2a2338, #1e192a 65%, #17131f);
            color: var(--base-text);
            box-shadow: 0 4px 12px rgb(0 0 0 / 0.55);
        }

        view-tooltip[data-tooltip-type="tip"] {
            padding-inline: var(--space-3);
        }

        view-tooltip [data-element="tooltip-tip-text"] {
            margin: 0;
        }

        fieldset {
            min-inline-size: 0;
            padding: var(--space-3);
            border: 5px solid var(--base-border);
            border-image: url("data:image/png;base64,{{district-frame}}") 20 / 10px repeat;

            &.accent {
                border-image-source: url("data:image/png;base64,{{district-frame-gold}}");
            }

            &.danger {
                border-image-source: url("data:image/png;base64,{{district-frame-ruby}}");
            }
        }

        fieldset > legend {
            margin-inline-start: 4px;
            background: var(--codecraft-legend-background, var(--base-bg));
            inline-size: fit-content;
            max-inline-size: 100%;
            padding-inline: var(--space-2);
            overflow-wrap: anywhere;
        }

        [role="tablist"] {
            display: flex;
            gap: var(--space-2);
            list-style: none;
        }

        [role="tablist"] > [role="tab"] {
            display: block;
            position: relative;
            padding: var(--space-2) var(--space-3);
            border: 0;
            border-radius: 0;
            background: var(--surface);
            color: var(--text-muted);
        }

        [role="tablist"] > [role="tab"]:is(:hover, [aria-selected="true"]):not(:disabled) {
            background: var(--surface-elevated);
            color: var(--accent);
        }

        [role="tablist"] > [role="tab"][aria-selected="true"] {
            font-weight: 700;
        }

        [role="tablist"] > [role="tab"]:focus-visible {
            outline: 2px solid var(--accent);
            outline-offset: -3px;
        }

        [role="tablist"] > [role="tab"]:disabled {
            opacity: 0.55;
            cursor: default;
        }

        [role="tablist"] > [role="tab"]::before,
        [role="tablist"] > [role="tab"]::after {
            content: "";
            position: absolute;
            inset: 0;
            pointer-events: none;
        }

        [role="tablist"] > [role="tab"]::before {
            padding-inline: 6px;
            background:
                url("data:image/png;base64,{{plaque-frame-tl}}") left top / 6px 6px no-repeat padding-box,
                url("data:image/png;base64,{{plaque-frame-tr}}") right top / 6px 6px no-repeat padding-box,
                url("data:image/png;base64,{{plaque-frame-bl}}") left bottom / 6px 6px no-repeat padding-box,
                url("data:image/png;base64,{{plaque-frame-br}}") right bottom / 6px 6px no-repeat padding-box,
                url("data:image/png;base64,{{plaque-frame-t}}") left top / 16px 6px repeat-x content-box,
                url("data:image/png;base64,{{plaque-frame-b}}") left bottom / 16px 6px repeat-x content-box;
        }

        [role="tablist"] > [role="tab"]::after {
            padding-block: 6px;
            background:
                url("data:image/png;base64,{{plaque-frame-l}}") left top / 6px 12px repeat-y content-box,
                url("data:image/png;base64,{{plaque-frame-r}}") right top / 6px 12px repeat-y content-box;
        }

    }

    @media (forced-colors: none) {
        main > footer,
        :host > footer,
        view-area > :not([slot]) > footer {
            --codecraft-footer-strap: url("data:image/png;base64,{{poutre-strap}}");
            --codecraft-footer-tile-height: 37px;
            justify-content: space-between;
            min-block-size: var(--codecraft-footer-tile-height);
            padding-inline: var(--space-2);
            background: url("data:image/png;base64,{{poutre-ornament}}") left top / 28px var(--codecraft-footer-tile-height) repeat var(--surface);

            & > output {
                flex: 0 1 auto;
                align-self: stretch;
                align-content: center;
                min-block-size: var(--codecraft-footer-tile-height);
                padding: var(--space-2) 18px;
                background:
                    var(--codecraft-footer-strap) left top / 14px var(--codecraft-footer-tile-height) repeat-y,
                    var(--codecraft-footer-strap) right top / 14px var(--codecraft-footer-tile-height) repeat-y,
                    linear-gradient(rgb(18 12 10 / 0.6), rgb(18 12 10 / 0.6)),
                    url("data:image/png;base64,{{poutre-plain}}") left top / 3px var(--codecraft-footer-tile-height) repeat;
            }

            /* An empty live output should not take up room in the flex row. */
            & > output:empty {
                position: absolute;
                min-block-size: 0;
                padding: 0;
                background: none;
            }
        }
    }

    @media (forced-colors: none) {
        /* Interactive column headers have individual button faces instead of a shared strip. */
        table:not([data-layout="separate"]) > thead:not(:has(> tr > th[scope="col"][role="button"]:is([aria-pressed], [aria-selected]))),
        table[data-layout="separate"] > thead > tr > :is(th, td):not(th[scope="col"][role="button"]:is([aria-pressed], [aria-selected])) {
            background:
                url("data:image/png;base64,{{entete-l}}") left center / 16px 100% no-repeat,
                url("data:image/png;base64,{{entete-r}}") right center / 16px 100% no-repeat,
                url("data:image/png;base64,{{entete-m}}") left center / 2400px 100% repeat-x
                #2e2016;
        }

        table[data-layout="separate"] > thead > tr > :is(th, td):not(th[scope="col"][role="button"]:is([aria-pressed], [aria-selected])) {
            padding-inline: 16px;
        }

        table:not([data-layout="separate"]) > thead:not(:has(> tr > th[scope="col"][role="button"]:is([aria-pressed], [aria-selected]))) {
            & > tr > :is(th, td):first-child {
                padding-inline-start: 16px;
            }

            & > tr > :is(th, td):last-child {
                padding-inline-end: 16px;
            }
        }

        table > thead > tr {
            height: 30px;
        }

        thead > tr > th[scope="col"][role="button"]:is([aria-pressed], [aria-selected]) {
            padding-inline: var(--space-2);
            background-size: min(8px, 32%) 100%, min(8px, 32%) 100%, 800px 100%;
            box-shadow: none;
            text-align: center;
        }

        col[aria-selected="true"] {
            background: var(--intent-soft-bg);
        }
    }

    table:not([data-layout="separate"]) {
        border-inline: 1px solid var(--base-border);
        border-block-end: 1px solid var(--base-border);

        &:not(:has(> thead)) {
            border-block-start: 1px solid var(--base-border);
        }

        & > tbody > tr + tr > :is(th, td) {
            border-block-start: 1px solid var(--base-border);
        }
    }

    label:has(> :is(input:not([type="hidden"]), select)) {
        display: inline-flex;
        align-items: center;
        gap: var(--space-2);
        max-inline-size: 100%;
        white-space: nowrap;

        & > :is(input:not([type="hidden"]), select) {
            min-inline-size: 0;
        }
    }

    @media (forced-colors: none) {
        :is(
            input:is(:not([type]), [type="text"], [type="number"], [type="search"], [type="url"], [type="email"], [type="password"]),
            select:not([part~="view-select"], [multiple]):is(:not([size]), [size="1"])
        ) {
            background-color: #18110e;
            border: 1px solid var(--codecraft-field-alert, #8a6334);
            border-radius: 0;
            color: var(--text);
            color-scheme: dark;
            box-shadow: inset 0 1px 2px #0c0806, inset 0 -1px #4a3525;

            &:hover:not(:disabled) {
                border-color: var(--codecraft-field-alert, #a37a49);
            }

            &:focus-visible {
                outline: 2px solid var(--accent);
                outline-offset: -2px;
            }

            &:is(:user-invalid, [aria-invalid="true"], .danger, .danger > *) {
                --codecraft-field-alert: var(--danger);
            }

            &:is(:user-invalid, [aria-invalid="true"], .danger, .danger > *):focus-visible {
                outline-color: var(--danger);
            }

            &:disabled {
                opacity: 0.6;
            }
        }

        select:not([part~="view-select"], [multiple]):is(:not([size]), [size="1"]) {
            appearance: none;
            padding-inline-end: var(--space-6);
            background-image:
                linear-gradient(45deg, transparent 50%, #cdb98f 50%),
                linear-gradient(135deg, #cdb98f 50%, transparent 50%);
            background-position: right 13px center, right 8px center;
            background-size: 5px 5px;
            background-repeat: no-repeat;
        }
    }

    /* Keep this inside the select's shadow root so the picker can opt in below. */
    :where(select[part~="view-select"]) {
        appearance: none;
    }

    /* Keep native popups for unsupported engines, forced colors, and listboxes. */
    @supports (appearance: base-select) and selector(select::picker-icon) and selector(select::picker(select)) {
        @media (forced-colors: none) {
            select:not([multiple]):is(:not([size]), [size="1"]) {
                appearance: base-select;

                &::picker-icon {
                    display: none;
                }

                &::picker(select) {
                    appearance: base-select;
                    margin: 0;
                    padding: var(--space-1);
                    inline-size: max-content;
                    min-inline-size: 0;
                    max-inline-size: calc(100dvw - var(--space-3));
                    max-block-size: min(18rem, 70dvh);
                    scrollbar-width: thin;
                    scrollbar-color: var(--base-text-muted) transparent;
                    overflow-x: hidden;
                    overflow-y: auto;
                    border: 1px solid var(--accent);
                    border-radius: 0;
                    background: var(--surface-elevated);
                    color: var(--text);
                    box-shadow: 0 6px 18px rgb(0 0 0 / 0.45);
                    font: inherit;
                }

                & optgroup {
                    color: var(--text-muted);
                }

                & option {
                    padding: var(--space-2) var(--space-3);
                    color: var(--text);
                    font-weight: normal;
                    white-space: normal;
                    overflow-wrap: anywhere;
                }

                & option[hidden] {
                    display: none;
                }

                & option:checked:not(:disabled) {
                    background: var(--intent-soft-bg);
                    color: var(--intent-soft-fg);
                }

                & option:not(:disabled):is(:hover, :focus-visible) {
                    background: var(--accent);
                    color: var(--base-ink);
                }

                & option:disabled {
                    color: var(--text-muted);
                }
            }
        }
    }
}
