@layer theme {
    :root {
        --base-bg: #1a1411;
        --surface: #241a14;
        --surface-elevated: #35261c;
        --base-border: #6d5036;
        --base-text: #f6ead0;
        --base-text-muted: #cdb98f;
        --base-ink: #140e0b;
        --accent: #f2c25a;
    }

    @media (forced-colors: none) {
        @supports selector(::-webkit-scrollbar) {
            ::-webkit-scrollbar {
                width: 9px;
                height: 9px;
            }

            ::-webkit-scrollbar-track,
            ::-webkit-scrollbar-corner {
                background: transparent;
            }

            ::-webkit-scrollbar-thumb {
                border: 1px solid transparent;
                border-radius: 999px;
                background: var(--base-text-muted) padding-box;
            }

            ::-webkit-scrollbar-thumb:hover {
                background-color: var(--base-text);
            }

            ::-webkit-scrollbar-button {
                display: none;
            }
        }

        @supports not selector(::-webkit-scrollbar) {
            * {
                scrollbar-width: thin;
                scrollbar-color: var(--base-text-muted) transparent;
            }
        }
    }

    view-area {
        padding: 14px;
    }

    view-area::before,
    view-area::after {
        content: "";
        position: absolute;
        inset: 0;
        pointer-events: none;
    }

    /* Layer the original strips instead of using border-image, which can fail
       to repaint after splitting panes in WebKit. Clip the strips at the corners. */
    view-area::before {
        padding-inline: 14px;
        background:
            url("data:image/png;base64,{{baguette-tl}}") left top / 14px 14px no-repeat padding-box,
            url("data:image/png;base64,{{baguette-tr}}") right top / 14px 14px no-repeat padding-box,
            url("data:image/png;base64,{{baguette-bl}}") left bottom / 14px 14px no-repeat padding-box,
            url("data:image/png;base64,{{baguette-br}}") right bottom / 14px 14px no-repeat padding-box,
            url("data:image/png;base64,{{baguette-t}}") left top / 2400px 14px repeat-x content-box,
            url("data:image/png;base64,{{baguette-b}}") left bottom / 2400px 14px repeat-x content-box;
    }

    view-area::after {
        padding-block: 14px;
        background:
            url("data:image/png;base64,{{baguette-l}}") left top / 14px 2400px repeat-y content-box,
            url("data:image/png;base64,{{baguette-r}}") right top / 14px 2400px repeat-y content-box;
    }

    view-popup::part(container) {
        position: relative;
        padding: 14px;
        border: 0;
        box-shadow: var(--shadow);
        overflow: visible;
    }

    :host(view-popup) [part~="container"]::before,
    :host(view-popup) [part~="container"]::after {
        content: "";
        position: absolute;
        inset: 0;
        pointer-events: none;
    }

    :host(view-popup) [part~="container"]::before {
        z-index: 1;
        padding-inline: 34px;
        background:
            url("data:image/png;base64,{{cadre-tl}}") left top / 34px 34px no-repeat padding-box,
            url("data:image/png;base64,{{cadre-tr}}") right top / 34px 34px no-repeat padding-box,
            url("data:image/png;base64,{{cadre-bl}}") left bottom / 34px 34px no-repeat padding-box,
            url("data:image/png;base64,{{cadre-br}}") right bottom / 34px 34px no-repeat padding-box,
            url("data:image/png;base64,{{cadre-t}}") left top / 2400px 14px repeat-x content-box,
            url("data:image/png;base64,{{cadre-b}}") left bottom / 2400px 14px repeat-x content-box;
    }

    :host(view-popup) [part~="container"]::after {
        padding-block: 34px;
        background:
            url("data:image/png;base64,{{cadre-l}}") left top / 14px 2400px repeat-y content-box,
            url("data:image/png;base64,{{cadre-r}}") right top / 14px 2400px repeat-y content-box;
    }

    view-area::part(header),
    view-popup::part(header) {
        display: flex;
        align-items: center;
        gap: var(--space-2);
        min-inline-size: 0;
        min-block-size: 36px;
        padding-inline: 20px;
        border: 0;
        background:
            url("data:image/png;base64,{{bandeau-l}}") left center / 20px 100% no-repeat padding-box,
            url("data:image/png;base64,{{bandeau-r}}") right center / 20px 100% no-repeat padding-box,
            url("data:image/png;base64,{{bandeau-m}}") left center / 2400px 100% repeat-x content-box
            #231b27;
    }

    view-area::part(view-select) {
        flex: 0 0 auto;
        field-sizing: content;
        min-inline-size: 0;
        max-inline-size: 45%;
        min-block-size: var(--control-height);
        padding-inline: var(--space-2) var(--space-5);
        border: 0;
        border-radius: 0;
        color: var(--base-text);
        color-scheme: dark;
        background:
            linear-gradient(45deg, transparent 50%, currentColor 50%) right 8px center / 4px 4px no-repeat,
            linear-gradient(135deg, currentColor 50%, transparent 50%) right 4px center / 4px 4px no-repeat;
        font: inherit;
        font-weight: 700;
        cursor: pointer;
    }

    view-area::part(view-select):hover {
        color: var(--accent);
    }

    view-area::part(view-select):focus-visible {
        outline: 2px solid var(--border-focus);
        outline-offset: -2px;
    }

    view-popup > [slot="title"] {
        min-inline-size: 0;
        overflow-wrap: anywhere;
    }

    view-popup::part(close) {
        --codecraft-close-size: 32px;
        position: absolute;
        inset-block-start: calc(var(--codecraft-close-size) / -2);
        inset-inline-end: calc(var(--codecraft-close-size) / -2);
        z-index: 2;
        inline-size: var(--codecraft-close-size);
        block-size: var(--codecraft-close-size);
        min-block-size: 0;
        margin: 0;
        padding: 0;
        border: 0;
        border-radius: 50%;
        background: url("data:image/png;base64,{{medaillon}}") center / 100% 100% no-repeat var(--surface);
        color: var(--base-text);
        font-size: 16px;
    }

    view-popup::part(close):hover {
        filter: brightness(1.25);
    }

    view-popup::part(close):active {
        filter: brightness(0.85);
    }

    view-popup::part(close):focus-visible {
        outline: 2px solid var(--base-text);
        outline-offset: -2px;
    }

    @media (forced-colors: active) {
        view-popup::part(close) {
            border: 1px solid ButtonText;
            background: ButtonFace;
            color: ButtonText;
        }

        view-popup::part(close):focus-visible {
            outline-color: Highlight;
        }
    }

    view-area [slot="header-controls"],
    view-popup > [slot="header-controls"] {
        flex: 0 1 auto;
        margin-inline-start: auto;
        flex-wrap: nowrap;
        justify-content: safe flex-end;
        overflow-x: auto;
    }

    @media (forced-colors: none) {
        button:not([part~="close"], [slot="header-controls"], [slot="header-controls"] *, [role="tablist"] > [role="tab"]) {
            --codecraft-button-art: url("data:image/png;base64,{{btn-n-l}}"), url("data:image/png;base64,{{btn-n-r}}"), url("data:image/png;base64,{{btn-n-m}}");
            background: var(--codecraft-button-art);
            background-position: left center, right center, left center;
            background-size: 8px 100%, 8px 100%, 800px 100%;
            background-repeat: no-repeat, no-repeat, repeat-x;
            border: 0;
            border-radius: 0;
            color: var(--base-text);
            transition: none;

            &.accent {
                color: var(--accent);
            }

            &:hover:enabled {
                --codecraft-button-art: url("data:image/png;base64,{{btn-h-l}}"), url("data:image/png;base64,{{btn-h-r}}"), url("data:image/png;base64,{{btn-h-m}}");
            }

            &:active:enabled {
                --codecraft-button-art: url("data:image/png;base64,{{btn-p-l}}"), url("data:image/png;base64,{{btn-p-r}}"), url("data:image/png;base64,{{btn-p-m}}");
            }

            &.danger {
                --codecraft-button-art: url("data:image/png;base64,{{btn-or-n-l}}"), url("data:image/png;base64,{{btn-or-n-r}}"), url("data:image/png;base64,{{btn-or-n-m}}");
            }

            &.danger:hover:enabled {
                --codecraft-button-art: url("data:image/png;base64,{{btn-or-h-l}}"), url("data:image/png;base64,{{btn-or-h-r}}"), url("data:image/png;base64,{{btn-or-h-m}}");
            }

            &.danger:active:enabled {
                --codecraft-button-art: url("data:image/png;base64,{{btn-or-p-l}}"), url("data:image/png;base64,{{btn-or-p-r}}"), url("data:image/png;base64,{{btn-or-p-m}}");
            }

            &:focus-visible {
                outline: 2px solid var(--accent);
                outline-offset: -2px;
            }

            &:disabled {
                opacity: 0.55;
                cursor: default;
            }
        }
    }

    @media (forced-colors: none) {
        fieldset {
            min-inline-size: 0;
            padding: var(--space-3);
            border: 2px solid var(--accent);
        }

        fieldset > legend {
            inline-size: fit-content;
            max-inline-size: 100%;
            padding-inline: var(--space-2);
            overflow-wrap: anywhere;
        }

        [role="tablist"] {
            display: flex;
            gap: var(--space-2);
            list-style: none;
        }

        [role="tablist"] > [role="tab"] {
            display: block;
            position: relative;
            padding: var(--space-2) var(--space-3);
            border: 0;
            border-radius: 0;
            background: var(--surface);
            color: var(--text-muted);
        }

        [role="tablist"] > [role="tab"]:is(:hover, [aria-selected="true"]):not(:disabled) {
            background: var(--surface-elevated);
            color: var(--accent);
        }

        [role="tablist"] > [role="tab"][aria-selected="true"] {
            font-weight: 700;
        }

        [role="tablist"] > [role="tab"]:focus-visible {
            outline: 2px solid var(--accent);
            outline-offset: -3px;
        }

        [role="tablist"] > [role="tab"]:disabled {
            opacity: 0.55;
            cursor: default;
        }

        [role="tablist"] > [role="tab"]::before,
        [role="tablist"] > [role="tab"]::after {
            content: "";
            position: absolute;
            inset: 0;
            pointer-events: none;
        }

        [role="tablist"] > [role="tab"]::before {
            padding-inline: 6px;
            background:
                url("data:image/png;base64,{{plaque-frame-tl}}") left top / 6px 6px no-repeat padding-box,
                url("data:image/png;base64,{{plaque-frame-tr}}") right top / 6px 6px no-repeat padding-box,
                url("data:image/png;base64,{{plaque-frame-bl}}") left bottom / 6px 6px no-repeat padding-box,
                url("data:image/png;base64,{{plaque-frame-br}}") right bottom / 6px 6px no-repeat padding-box,
                url("data:image/png;base64,{{plaque-frame-t}}") left top / 16px 6px repeat-x content-box,
                url("data:image/png;base64,{{plaque-frame-b}}") left bottom / 16px 6px repeat-x content-box;
        }

        [role="tablist"] > [role="tab"]::after {
            padding-block: 6px;
            background:
                url("data:image/png;base64,{{plaque-frame-l}}") left top / 6px 12px repeat-y content-box,
                url("data:image/png;base64,{{plaque-frame-r}}") right top / 6px 12px repeat-y content-box;
        }

    }

    @media (forced-colors: none) {
        main > footer,
        :host > footer,
        :is(view-area, view-popup) > :not([slot]) > footer {
            --codecraft-footer-strap: url("data:image/png;base64,{{poutre-strap}}");
            justify-content: space-between;
            min-block-size: 32px;
            padding-inline: var(--space-2);
            background: url("data:image/png;base64,{{poutre-ornament}}") left top / 28px 32px repeat var(--surface);

            & > output {
                flex: 0 1 auto;
                align-self: stretch;
                align-content: center;
                min-block-size: 32px;
                padding: var(--space-2) 18px;
                background:
                    var(--codecraft-footer-strap) left center / 14px 100% no-repeat,
                    var(--codecraft-footer-strap) right center / 14px 100% no-repeat,
                    linear-gradient(rgb(18 12 10 / 0.6), rgb(18 12 10 / 0.6)),
                    url("data:image/png;base64,{{poutre-plain}}") left center / 3px 100% repeat-x;
            }

            /* An empty live output should not take up room in the flex row. */
            & > output:empty {
                position: absolute;
                min-block-size: 0;
                padding: 0;
                background: none;
            }
        }
    }

    /* Keep this inside the select's shadow root so the picker can opt in below. */
    :where(select[part~="view-select"]) {
        appearance: none;
    }

    /* Keep native popups for unsupported engines, forced colors, and listboxes. */
    @supports (appearance: base-select) and selector(select::picker-icon) and selector(select::picker(select)) {
        @media (forced-colors: none) {
            select:not([multiple]):is(:not([size]), [size="1"]) {
                appearance: base-select;

                &[part~="view-select"]::picker-icon {
                    display: none;
                }

                &::picker(select) {
                    appearance: base-select;
                    margin: 0;
                    padding: var(--space-1);
                    inline-size: max-content;
                    min-inline-size: 0;
                    max-inline-size: calc(100dvw - var(--space-3));
                    max-block-size: min(18rem, 70dvh);
                    scrollbar-width: thin;
                    scrollbar-color: var(--base-text-muted) transparent;
                    overflow-x: hidden;
                    overflow-y: auto;
                    border: 1px solid var(--accent);
                    border-radius: 0;
                    background: var(--surface-elevated);
                    color: var(--text);
                    box-shadow: 0 6px 18px rgb(0 0 0 / 0.45);
                    font: inherit;
                }

                & optgroup {
                    color: var(--text-muted);
                }

                & option {
                    padding: var(--space-2) var(--space-3);
                    color: var(--text);
                    font-weight: normal;
                    white-space: normal;
                    overflow-wrap: anywhere;
                }

                & option[hidden] {
                    display: none;
                }

                & option:checked:not(:disabled) {
                    background: var(--intent-soft-bg);
                    color: var(--intent-soft-fg);
                }

                & option:not(:disabled):is(:hover, :focus-visible) {
                    background: var(--accent);
                    color: var(--base-ink);
                }

                & option:disabled {
                    color: var(--text-muted);
                }
            }
        }
    }
}
